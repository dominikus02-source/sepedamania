generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED
}

enum VoucherType {
  PERCENTAGE
  NOMINAL
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITING_FOR_ITEM
  ITEM_RECEIVED
  REFUND_PROCESSING
  REPLACEMENT_SHIPPING
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  SIZE_OR_VARIANT_ISSUE
  MISSING_PART
  OTHER
}

enum PreferredResolution {
  REFUND
  REPLACEMENT
  STORE_CREDIT
  ADMIN_HELP
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  phone     String?
  role      Role      @default(CUSTOMER)
  password  String?
  image     String?
  emailVerified DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  totpSecret String?
  totpEnabled Boolean @default(false)
  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  returnRequests ReturnRequest[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  label     String
  recipient String
  phone     String
  province  String
  city      String
  district  String
  postalCode String
  detail    String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  image       String?
  brandId     String?
  brand       Brand?    @relation(fields: [brandId], references: [id])
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(999)
  description String    @default("")
  color       String    @default("#F5A623")
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(999)
  description String    @default("")
  products    Product[]
  categories  Category[]
  createdAt   DateTime  @default(now())
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  sku         String          @unique
  description String
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  brandId     String
  brand       Brand           @relation(fields: [brandId], references: [id])
  price       Decimal
  salePrice   Decimal?
  weight      Int
  images      String[]
  videoUrls   String[]        @default([])
  specs       Json            @default("[]")
  variants    ProductVariant[]
  stock       Int             @default(0)
  sold        Int             @default(0)
  isActive    Boolean         @default(true)
  metaTitle   String?
  metaDescription String?
  reviews     Review[]
  orderItems  OrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([slug])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  value     String
  price     Decimal?
  stock     Int      @default(0)
  sku       String?
}

model Order {
  id               String         @id @default(cuid())
  orderNumber      String         @unique
  userId           String?
  user             User?          @relation(fields: [userId], references: [id])
  guestEmail       String?
  guestName        String?
  guestPhone       String?
  items            OrderItem[]
  paymentLogs      PaymentLog[]
  returnRequests   ReturnRequest[]
  status           OrderStatus    @default(PENDING_PAYMENT)
  subtotal         Decimal
  shippingCost     Decimal        @default(0)
  discount         Decimal        @default(0)
  total            Decimal
  shippingAddress  Json
  courier          String
  courierService   String
  trackingNumber   String?
  paymentMethod    String
  paymentStatus    PaymentStatus  @default(UNPAID)
  paymentProvider  String         @default("MIDTRANS")
  midtransOrderId  String?        @unique
  snapToken        String?
  redirectUrl      String?
  voucherCode      String?
  notes            String?
  paidAt           DateTime?
  cancelledAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model PaymentLog {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id])
  provider           String   @default("MIDTRANS")
  eventType          String
  transactionStatus  String?
  fraudStatus        String?
  rawPayload         Json
  createdAt          DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model ReturnRequest {
  id                   String             @id @default(cuid())
  returnNumber         String             @unique
  orderId              String
  order                Order              @relation(fields: [orderId], references: [id])
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  items                Json               @default("[]")
  status               ReturnStatus       @default(REQUESTED)
  reason               ReturnReason
  detail               String
  preferredResolution  PreferredResolution
  evidenceImages       Json               @default("[]")
  adminNote            String?
  rejectionReason      String?
  refundAmount         Decimal?
  trackingNumber       String?
  returnShippingProvider String?
  reviewedAt           DateTime?
  approvedAt           DateTime?
  receivedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  order                Order   @relation(fields: [orderId], references: [id])
  productId            String
  product              Product @relation(fields: [productId], references: [id])
  variantId            String?
  name                 String
  productSlug          String?
  price                Decimal
  qty                  Int
  subtotal             Decimal
  image                String
  selectedVariantName  String?
  selectedAttributes   Json?

  @@index([orderId])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  images    String[]
  createdAt DateTime @default(now())

  @@index([productId])
}

model Voucher {
  id          String      @id @default(cuid())
  code        String      @unique
  type        VoucherType
  value       Decimal
  minPurchase Decimal     @default(0)
  maxDiscount Decimal?
  quota       Int?
  used        Int         @default(0)
  expiresAt   DateTime?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  change    Int
  reason    String
  createdAt DateTime @default(now())
}

model StoreSettings {
  id              String  @id @default("store")
  storeName       String  @default("SEPEDAMANIA")
  storeLogo       String?
  storeFavicon    String?
  storeAddress    String?
  storeCity       String?
  storeProvince   String?
  storePostalCode String?
  storePhone      String?
  waNumber        String  @default("628xxxxxxxxx")
  email           String?
  socialInstagram String?
  socialFacebook  String?
  socialTiktok    String?
  ogImage         String?
  metaDescription String?
  maintenanceMode Boolean @default(false)
  rajaongkirKey   String?
  rajaongkirOriginCity String?
  midtransMerchantId String?
  midtransNotificationAuthKey String?
  codActive       Boolean @default(false)
  codAreas        Json    @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
